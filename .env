
# ──────────────────────────────────────────────────────────────
# Cloudflare Account
# ──────────────────────────────────────────────────────────────
# Run `wrangler whoami` to get your account ID
# Run `wrangler auth token` to get your API token
CLOUDFLARE_ACCOUNT_ID=b73b80fa62deef032d3c08248cf2f30b
CLOUDFLARE_API_TOKEN=your-api-token-here

# ──────────────────────────────────────────────────────────────
# Workers AI
# ──────────────────────────────────────────────────────────────
AI_MODEL=@cf/qwen/qwen3-30b-a3b-fp8
AI_PROVIDER=cloudflare
AI_GATEWAY_ID=ai_dragon

# ──────────────────────────────────────────────────────────────
# AI Gateway REST API endpoints
# ──────────────────────────────────────────────────────────────
AI_RUN_URL=https://api.cloudflare.com/client/v4/accounts/b73b80fa62deef032d3c08248cf2f30b/ai/run
AI_CHAT_COMPLETIONS_URL=https://api.cloudflare.com/client/v4/accounts/b73b80fa62deef032d3c08248cf2f30b/ai/v1/chat/completions
AI_RESPONSES_URL=https://api.cloudflare.com/client/v4/accounts/b73b80fa62deef032d3c08248cf2f30b/ai/v1/responses

# AI Gateway WebSocket (persistent keep-alive)
AI_GATEWAY_WS_URL=wss://gateway.ai.cloudflare.com/v1/b73b80fa62deef032d3c08248cf2f30b/ai_dragon/

# ──────────────────────────────────────────────────────────────
# AI Search
# ──────────────────────────────────────────────────────────────
AI_SEARCH_INSTANCE=flytripvisa
AI_SEARCH_NAMESPACE=default

# ──────────────────────────────────────────────────────────────
# D1 Databases
# ──────────────────────────────────────────────────────────────
# DB — primary database (266 KB, has application data)
D1_DATABASE_NAME=flytripvisa-db
D1_DATABASE_ID=f274effd-ff6e-4c75-b8a8-4083726232fe

# DB2 — secondary database (28 KB)
D1_DATABASE2_NAME=flydb-d1
D1_DATABASE2_ID=bc449b24-09b3-4ecd-a599-b78d0127f594

# ──────────────────────────────────────────────────────────────
# KV Namespace
# ──────────────────────────────────────────────────────────────
KV_BINDING_ID=2085403b5d774d1bbd333bcb8ea0d80b

# ──────────────────────────────────────────────────────────────
# R2 Buckets
# ──────────────────────────────────────────────────────────────
R2_BUCKET=flytripvisa-media
R2_AI_CHAT_BUCKET=ai-chat

# ──────────────────────────────────────────────────────────────
# Browser Run
# ──────────────────────────────────────────────────────────────
BROWSER_BINDING=BROWSER

# ──────────────────────────────────────────────────────────────
# App Configuration
# ──────────────────────────────────────────────────────────────
APP_NAME=FlyTripVisa Personal Agent
APP_DOMAIN=flytripvisa.site
APP_URL=https://flytripvisa.site
AI_CHAT_URL=https://ai.flytripvisa.site
MINIPROGRAM_URL=https://mini.flytripvisa.site
ENVIRONMENT=production
ENABLE_STREAMING=true
LOG_LEVEL=info
MAX_HISTORY=40

SYSTEM_PROMPT='You are FlyTripVisa Personal Agent, a helpful AI assistant integrated with the FlyTripVisa platform. You can help with visa information, travel planning, project management, and answer questions about the FlyTripVisa service. You support streaming responses for real-time chat. Be concise, helpful, and professional. You have access to tools for web browsing, database queries, file storage, and more.'
